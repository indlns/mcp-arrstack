# ──────────────────────────────────────────────
# MCP ARR Stack — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Sonarr (TV Series) ─────────────────────────
SONARR_HOST=http://sonarr:8989
SONARR_API_KEY=your_sonarr_api_key_here

# ── Radarr (Movies) ────────────────────────────
RADARR_HOST=http://radarr:7878
RADARR_API_KEY=your_radarr_api_key_here

# ── Lidarr (Music) ─────────────────────────────
LIDARR_HOST=http://lidarr:8686
LIDARR_API_KEY=your_lidarr_api_key_here

# ── Prowlarr (Indexer Management) ─────────────
PROWLARR_HOST=http://prowlarr:9696
PROWLARR_API_KEY=your_prowlarr_api_key_here

# ── Readarr (Books) ───────────────────────────
READARR_HOST=http://readarr:8787
READARR_API_KEY=your_readarr_api_key_here

# ── Seerr (Request Management) ────────────────
SEERR_HOST=http://seerr:5055
SEERR_API_KEY=your_seerr_api_key_here

# ── Tautulli (Plex Statistics) ─────────────────
TAUTULLI_HOST=http://tautulli:8181
TAUTULLI_API_KEY=your_tautulli_api_key_here

# ── Plex Media Server ─────────────────────────
PLEX_HOST=http://plex:32400
PLEX_TOKEN=your_plex_token_here

# ── Global Settings ────────────────────────────
LOG_LEVEL=INFO
CACHE_ENABLED=true
CACHE_TTL=300
REQUEST_TIMEOUT=30.0

# ── HTTP Transport Configuration ───────────────
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_API_KEY=
HTTP_CORS_ORIGINS=*
HTTP_SSL_CERTFILE=
HTTP_SSL_KEYFILE=
